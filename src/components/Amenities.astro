---
const items = [
  { label: "Lift", icon: "M5 3h14v18H5zM12 3v18M7.5 10l1.5-2 1.5 2M13.5 14l1.5 2 1.5-2" },
  { label: "Gym", icon: "M6 7v10M3 9v6M18 7v10M21 9v6M6 12h12" },
  { label: "Dedicated parking", icon: "M5 3h14v18H5zM10 17V8h3a2.5 2.5 0 010 5h-3" },
  { label: "Community hall", icon: "M16 11a3 3 0 100-6 3 3 0 000 6zM8 11a3 3 0 100-6 3 3 0 000 6zM2 20c0-3 3-5 6-5s6 2 6 5M14 15c3 0 8 1 8 5" },
  { label: "Fire-fighting provisions", icon: "M12 3c1 4 5 5 5 10a5 5 0 01-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-5 1-9z" },
  { label: "DG backup", icon: "M13 2L4 14h7l-1 8 9-12h-7z" },
  { label: "Gated community", icon: "M4 21V8l8-5 8 5v13M8 21V11M16 21V11M4 14h16" },
  { label: "Rooftop sitting area", icon: "M3 20h18M6 16h12M7 16v4M17 16v4M12 3v2M5.6 7.6l1.4 1.4M18.4 7.6L17 9M8 13a4 4 0 018 0" },
];
---
<section class="amenities section" id="amenities">
  <div class="container">
    <p class="eyebrow" data-reveal>Amenities</p>
    <h2 class="sr-only">Amenities</h2>
    <ul class="amenities__grid" data-stagger>
      {items.map((a) => (
        <li class="amenity">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
            <path d={a.icon} />
          </svg>
          <span>{a.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
