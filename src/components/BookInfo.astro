---
import { PHONE, MAPS_URL } from "../config";
const EMAIL = "contact@adityaconstruction.example";
---
<h2 id="info-title" class="booking__title">Aditya Construction</h2>

<div class="info">
  <div class="info__block">
    <h3 class="info__label">Address</h3>
    <address>Jhagadapadhi, Sunhat,<br />Balasore, Odisha 756002</address>
  </div>
  <div class="info__block">
    <h3 class="info__label">Contact</h3>
    <p><a href={`tel:${PHONE.tel}`}>{PHONE.display}</a></p>
    <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
  </div>
  <div class="info__block">
    <h3 class="info__label">Working hours</h3>
    <p>Mon - Sun: 9:00 AM - 7:00 PM IST</p>
  </div>
  <a class="info__map" href={MAPS_URL} target="_blank" rel="noopener" tabindex="-1">
    <img
      src="/img/map.webp"
      alt="Map showing the Aditya Construction office in Balasore, Odisha"
      width="1200"
      height="800"
      loading="lazy"
    />
  </a>
  <a class="info__link" href={MAPS_URL} target="_blank" rel="noopener">Open in Google Maps &#8599;</a>
</div>

<style>
  a.info__map { display: block; }
</style>