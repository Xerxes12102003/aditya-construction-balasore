---
import { waLink } from "../config";
const brochure = waLink("Hello, please send me the Titli Enclave brochure.");
const rooms = [
  { name: "Living Cum Dining", size: `11'7" x 14'6"` },
  { name: "Bedroom 1", size: `13'7" x 11'` },
  { name: "Bedroom 2", size: `13'7" x 10'` },
  { name: "Kitchen", size: `7' x 11'` },
  { name: "Toilet 1", size: `4' x 6'6"` },
  { name: "Toilet 2", size: `4'5" x 6'6"` },
  { name: "Balcony", size: `7'8" x 5'7"` },
  { name: "Puja", size: `7' x 4'` },
];
---
<section class="plan section" id="floor-plan">
  <div class="container">
    <p class="eyebrow" data-reveal>Floor plan</p>
    <h2 class="sr-only">Floor plan</h2>
    <div class="plan__grid">
      <div class="plan__media" data-reveal>
        <img
          src="/img/floor-plan.webp"
          alt="3D floor plan of a 2 BHK apartment at Titli Enclave"
          width="1200"
          height="805"
          loading="lazy"
        />
      </div>
      <div class="plan__info" data-reveal>
        <table class="plan__table">
          <caption class="sr-only">Room dimensions</caption>
          <thead>
            <tr><th scope="col">Room</th><th scope="col">Dimensions</th></tr>
          </thead>
          <tbody>
            {rooms.map((r) => (
              <tr><th scope="row">{r.name}</th><td>{r.size}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="plan__note"></p>
        <a class="btn btn-primary" href={brochure} target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8zM14 3v5h5M9 13h6M9 17h6" /></svg>Send me the brochure on WhatsApp</a>
      </div>
    </div>
  </div>
</section>