---
const slides = [1, 2, 3, 4, 5].map((n) => `/img/placeholder/hero-${n}.svg`);
---
<section class="hero" data-slideshow aria-label="Featured work">
  <div class="hero__slides" aria-hidden="true">
    {slides.map((src, i) => (
      <div class={`hero__slide${i === 0 ? " is-active" : ""}`}>
        <img
          src={src}
          alt=""
          width="1600"
          height="900"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
        />
      </div>
    ))}
  </div>
  <div class="hero__overlay"></div>
  <div class="container hero__content">
    <h1 class="hero-title">We design what you will live in.</h1>
    <div class="hero__actions">
    </div>
  </div>
  <button class="hero__pause" type="button" data-pause aria-pressed="false">Pause</button>
</section>
<script>import "../assets/js/slideshow.js";</script>
