---
const places = [
  { name: "Padmavati Amusement Park", distance: "700 m" },
  { name: "NH 16 ", distance: "2.6 Km" },
  { name: "Railway Station", distance: "5 km" },
  { name: "Market", distance: "3 km" },
  { name: "Modern Public School", distance: "2.5 km" },
];
---
<section class="nearby section" id="nearby">
  <div class="container">
    <p class="eyebrow" data-reveal>Nearby Locations</p>
    <h2 class="sr-only">Nearby locations</h2>
    <ul class="nearby__grid" data-stagger>
      {places.map((p) => (
        <li class="place">
          <span class="place__name">{p.name}</span>
          <span class="place__distance">{p.distance}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
