---
const services = [
  { slug: "architectural-planning", title: "Architectural planning", icon: "M3 3h18v18H3zM3 12h9M12 3v18" },
  { slug: "structural-drawings", title: "Structural drawings", icon: "M4 20V8l8-4 8 4v12M4 14h16M9 20v-6M15 20v-6" },
  { slug: "civil-engineering", title: "Civil engineering and contracting", icon: "M2 20h20M5 20V9l7-5 7 5v11M9 20v-5h6v5" },
  { slug: "interior-design", title: "Interior design", icon: "M4 12V9a2 2 0 012-2h12a2 2 0 012 2v3M3 12a2 2 0 012 2v3h14v-3a2 2 0 012-2M6 17v2M18 17v2" },
  { slug: "landscape", title: "Landscape", icon: "M12 21v-7M12 14a5 5 0 100-10 5 5 0 000 10zM8 21h8" },
  { slug: "vastu", title: "Vastu consultancy", icon: "M12 3a9 9 0 100 18 9 9 0 000-18zM15.5 8.5l-2 5-5 2 2-5z" },
  { slug: "3d-visualisation", title: "3D visualisation and estimation", icon: "M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12L4 7.5M12 12v9" },
];
---
<section class="services section" id="services">
  <div class="container">
    <h2 class="eyebrow" data-reveal>Services</h2>
    <div class="services__grid" data-stagger>
      {services.map((s, i) => (
        <a class="service-card" href={`/book?service=${s.slug}`}>
          <div class="service-card__top">
            <span class="service-card__index">{String(i + 1).padStart(2, "0")}</span>
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
              <path d={s.icon} />
            </svg>
          </div>
          <span class="service-card__title">{s.title}</span>
          <span class="service-card__arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>
