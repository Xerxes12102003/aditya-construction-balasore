---
const ceo = {
  role: "Founder & CEO",
  name: "Er. Jyotiraditya Mishra",
  text: "Architecture and civil engineering vision.",
};
const team = [
  { role: "Structural Engineer", name: "Rahul Das", text: "Earthquake-safe structural detailing." },
  { role: "Interior Designer", name: "Sneha Patnaik", text: "Warm, space-efficient interiors." },
  { role: "Estimation Engineer", name: "Amit Sahoo", text: "Accurate budgets and material costing." },
  { role: "Site Supervisor", name: "Biswajit Nayak", text: "On-time, on-spec execution." },
];
---
<section class="team section" id="team">
  <div class="container">
    <p class="eyebrow" data-reveal>Team</p>
    <h2 class="sr-only">Meet The Team</h2>
    <div class="team__grid" data-stagger>
      <article class="team-card team-card--ceo">
        <p class="team-card__role">{ceo.role}</p>
        <h3 class="team-card__name">{ceo.name}</h3>
        <p class="team-card__text">{ceo.text}</p>
        <p class="team-card__foot"><span>Aditya Construction</span><span>Balasore, OD</span></p>
      </article>
      {team.map((m) => (
        <article class="team-card">
          <p class="team-card__role">{m.role}</p>
          <h3 class="team-card__name">{m.name}</h3>
          <p class="team-card__text">{m.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
