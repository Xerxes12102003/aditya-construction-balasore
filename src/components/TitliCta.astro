---
import { UNITS_TOTAL, waLink } from "../config";
const reserve = waLink("Hello, I'd like to reserve a 2 BHK at Titli Enclave.");
const brochure = waLink("Hello, please send me the Titli Enclave brochure.");
---
<section class="cta-band" aria-labelledby="titli-cta-title">
  <div class="container">
    <div class="cta-band__inner">
      <div class="cta-band__text" data-reveal>
        <h2 id="titli-cta-title">LIMITED ALLOCATION</h2>
        <h2 id="titli-cta-title">{UNITS_TOTAL} RESIDENCES ONLY!</h2>
        <p>Reserve Yours Before They're Sold Out</p>
      </div>
      <div class="cta-band__actions" data-reveal>
        <a class="btn btn-primary" href={reserve} target="_blank" rel="noopener">Reserve a Unit</a>
        <a class="btn btn-ghost-light" href={brochure} target="_blank" rel="noopener">Send me the brochure on WhatsApp</a>
      </div>
    </div>
   <p class="cta-band__disclaimer"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 110-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 100-5C13 2 12 7 12 7z" /></svg>Exciting discounts and gifts reserved for the first 3 bookings</p>
  </div>
</section>
