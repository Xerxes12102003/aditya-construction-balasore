---
import { UNITS_TOTAL } from "../config";
const stats = [
  { label: "Apartment configuration", value: "2 BHK" },
  { label: "Super Built-Up", value: "1,146 Sq.ft" },
  { label: "Total apartments", value: `${UNITS_TOTAL} Units` },
  { label: "100% Vastu Compiled", value: "Yes" },
];
---
<section class="stats" aria-label="Project at a glance">
  <div class="container">
    <dl class="stats__grid" data-stagger>
      {stats.map((s) => (
        <div class="stat">
          <dt class="stat__label">{s.label}</dt>
          <dd class="stat__value">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
