---
import Layout from "../layouts/Layout.astro";
import BookInfo from "../components/BookInfo.astro";

const services = [
  ["home-plan", "Home plan"],
  ["interiors", "Interiors"],
  ["commercial", "Commercial"],
  ["vastu", "Vastu"],
  ["titli-enclave", "Titli Enclave"],
  ["other", "Other"],
];
const slots = [];
for (let h = 9; h < 19; h++) {
  const fmt = (n) => `${((n + 11) % 12) + 1}:00 ${n < 12 ? "AM" : "PM"}`;
  slots.push(`${fmt(h)} - ${fmt(h + 1)}`);
}
---
<Layout title="Book a Consultation" description="Placeholder description.">
  <div class="container booking">
    <section class="booking__form" aria-labelledby="booking-title">
      <h1 id="booking-title" class="booking__title">Direct booking</h1>

      <div id="form-summary" class="form-summary" role="alert" tabindex="-1" hidden></div>

      <form id="booking-form" novalidate>
        <div class="field">
          <label for="name">Full name <span aria-hidden="true">*</span></label>
          <input id="name" name="name" type="text" placeholder="e.g. Priyabrata Mohapatra" autocomplete="name" required aria-required="true" aria-describedby="name-error" />
          <p class="field__error" id="name-error" hidden></p>
        </div>

        <div class="field">
          <label for="phone">Phone number (WhatsApp active) <span aria-hidden="true">*</span></label>
          <div class="phone">
            <span class="phone__prefix" aria-hidden="true">+91</span>
            <input id="phone" name="phone" type="tel" inputmode="numeric" maxlength="10" autocomplete="tel-national" required aria-required="true" aria-describedby="phone-error" />
          </div>
          <p class="field__error" id="phone-error" hidden></p>
        </div>

        <div class="field">
          <label for="service">Service requested <span aria-hidden="true">*</span></label>
          <select id="service" name="service" required aria-required="true" aria-describedby="service-error">
            <option value="" disabled selected>Select a service</option>
            {services.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
          <p class="field__error" id="service-error" hidden></p>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="date">Preferred date <span aria-hidden="true">*</span></label>
            <input id="date" name="date" type="date" required aria-required="true" aria-describedby="date-error" />
            <p class="field__error" id="date-error" hidden></p>
          </div>
          <div class="field">
            <label for="slot">Preferred time slot <span aria-hidden="true">*</span></label>
            <select id="slot" name="slot" required aria-required="true" aria-describedby="slot-error">
              <option value="" disabled selected>Select a slot</option>
              {slots.map((s) => <option value={s}>{s}</option>)}
            </select>
            <p class="field__error" id="slot-error" hidden></p>
          </div>
        </div>

        <div class="field">
          <label for="notes">Project scope &amp; notes</label>
          <textarea id="notes" name="notes" rows="4"></textarea>
        </div>

        <div class="field field--check">
          <input id="consent" name="consent" type="checkbox" required aria-required="true" aria-describedby="consent-error" />
          <label for="consent">I agree to be contacted via WhatsApp for scheduling and architectural documentation review. Compliant with Digital Personal Data Protection (DPDP) Act.</label>
          <p class="field__error" id="consent-error" hidden></p>
        </div>

        <button class="btn btn-primary booking__submit" type="submit">Send on WhatsApp &rarr;</button>
      </form>
    </section>

    <aside class="booking__info" aria-labelledby="info-title">
      <BookInfo />
    </aside>
  </div>
  <script>import "../assets/js/prefill.js";</script>
  <script>import "../assets/js/whatsapp.js";</script>
</Layout>
